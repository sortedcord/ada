# Runtime
NODE_ENV=development
LOG_LEVEL=info
HOST=127.0.0.1
API_PORT=3000
WEB_PORT=4173
REQUEST_ID_HEADER=x-request-id

# Local services
POSTGRES_PASSWORD=local-dev-change-this-password
DATABASE_URL=postgres://ada:local-dev-change-this-password@postgres:5432/ada
REDIS_URL=redis://redis:6379

# Generation provider (server/worker only; never expose these to the browser)
GENERATION_ENABLED=false
GENERATION_PROVIDER=aditya-gupta
GENERATION_BASE_URL=https://ai.adityagupta.dev/v1
GENERATION_API_KEY=replace-with-a-secret
GENERATION_API=openai-responses
GENERATION_MODELS_REFRESH_SECONDS=3600
GENERATION_DEFAULT_MODEL=Codex Proxy/gpt-5.6-luna

# Embeddings (optional; lexical retrieval works while disabled)
EMBEDDING_ENABLED=false
EMBEDDING_PROVIDER=aditya-gupta
EMBEDDING_BASE_URL=https://ai.adityagupta.dev/v1
EMBEDDING_API_KEY=replace-with-a-secret
EMBEDDING_MODEL=azure/text-embedding-ada-002
EMBEDDING_DIMENSIONS=1536
EMBEDDING_DISTANCE=cosine
EMBEDDING_BATCH_SIZE=64

# Remote exposure is disabled by default
REMOTE_ACCESS_ENABLED=false
AUTH_SESSION_SECRET=replace-with-a-long-random-secret
CORS_ORIGIN=http://127.0.0.1:4173
DEBUG_INSPECTORS_ENABLED=false
