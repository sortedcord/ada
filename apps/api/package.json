{
  "name": "@ada/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "lint": "eslint src",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests --config ../../vitest.config.ts",
    "test:integration": "vitest run --passWithNoTests --config ../../vitest.integration.config.ts"
  },
  "dependencies": {
    "@ada/architect": "workspace:*",
    "@ada/ai": "workspace:*",
    "@ada/config": "workspace:*",
    "@ada/contracts": "workspace:*",
    "@ada/db": "workspace:*",
    "@ada/domain": "workspace:*",
    "@ada/observability": "workspace:*",
    "@ada/prompts": "workspace:*",
    "@ada/scenario-tools": "workspace:*",
    "bullmq": "^5.81.5",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.5.0",
    "ioredis": "^5.11.1"
  },
  "devDependencies": {
    "tsx": "^4.20.5"
  }
}
