{
  "name": "ada",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@12.4.2",
  "engines": {
    "node": ">=24.21.0 <25"
  },
  "scripts": {
    "dev": "turbo run dev --parallel",
    "clean": "node scripts/clean.mjs",
    "ci:local": "bash scripts/ci-local.sh",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "turbo run test",
    "test:integration": "turbo run test:integration",
    "test:contract": "turbo run test:contract",
    "test:privacy": "turbo run test:privacy",
    "test:retrieval": "turbo run test:retrieval",
    "test:e2e": "turbo run test:e2e",
    "test:a11y": "turbo run test:a11y",
    "test:soak": "turbo run test:soak",
    "test:live-provider": "turbo run test:live-provider",
    "db:migrate": "turbo run db:migrate",
    "db:check": "turbo run db:check",
    "db:seed": "bash scripts/db-seed.sh",
    "db:reset": "bash scripts/dev-reset.sh",
    "projections:rebuild": "turbo run projections:rebuild",
    "embeddings:reindex": "turbo run embeddings:reindex",
    "backup": "bash scripts/backup.sh",
    "restore:verify": "bash scripts/restore-verify.sh",
    "security:scan": "pnpm audit --audit-level high",
    "sbom": "bash scripts/sbom.sh",
    "scenario:mcp": "pnpm --filter @ada/scenario-mcp start"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.10.0",
    "@typescript-eslint/eslint-plugin": "^8.46.0",
    "@typescript-eslint/parser": "^8.46.0",
    "@vitest/coverage-v8": "^3.2.7",
    "eslint": "^9.37.0",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-promise": "^7.2.1",
    "prettier": "^3.6.2",
    "turbo": "^2.5.8",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^3.2.4"
  }
}
