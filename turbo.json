{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": { "dependsOn": ["^build"], "outputs": ["dist/**", "build/**"] },
    "dev": { "cache": false, "persistent": true },
    "lint": { "dependsOn": ["^build"], "outputs": [] },
    "typecheck": { "dependsOn": ["^build"], "outputs": [] },
    "test": { "dependsOn": ["^build"], "cache": false },
    "test:integration": { "cache": false },
    "test:contract": { "dependsOn": ["^build"] },
    "test:privacy": { "dependsOn": ["^build"] },
    "test:retrieval": { "dependsOn": ["^build"] },
    "test:e2e": { "cache": false },
    "test:a11y": { "cache": false },
    "test:soak": { "cache": false },
    "test:live-provider": { "cache": false },
    "db:migrate": { "cache": false },
    "db:check": { "cache": false },
    "db:seed": { "cache": false },
    "db:reset": { "cache": false },
    "projections:rebuild": { "cache": false },
    "embeddings:reindex": { "cache": false },
    "clean": { "cache": false }
  }
}
